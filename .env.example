# development, beta or production
ENVIRONMENT=development
DEBUG=True

# Generate a unique long random value for each environment.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames accepted by Django. Required in beta/production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins. Include scheme and port when applicable.
# Required in beta/production; never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Only origins that need Django CSRF validation, such as an external Admin origin.
# Wildcards are not accepted.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:3000

# CORS credentials are intentionally disabled in the JWT Authorization-header API.

# HTTPS/security settings. Enable the proxy header only behind a trusted HTTPS proxy.
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER_ENABLED=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Set this only when DATABASE_URL is configured.
# DATABASE_URL=postgres://user:password@host:5432/database
